# Copy to .env for local development. Replace every placeholder before deploying.
NODE_ENV=development
PORT=5000

# MongoDB. Transaction workflows require a replica set (including locally).
MONGODB_URI=mongodb://localhost:27017/library?replicaSet=rs0&retryWrites=true&w=majority

# Client URLs (ngăn cách bằng dấu phẩy; đặt frontend độc giả đầu tiên để tạo link reset password)
CLIENT_URL=http://localhost:5173

# JWT Authentication (production: distinct random secrets, at least 32 characters each)
JWT_ACCESS_SECRET=local_access_secret_replace_before_production_0123456789
JWT_REFRESH_SECRET=local_refresh_secret_replace_before_production_9876543210
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# Cookie Settings
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Google Identity Services web client ID (same OAuth client can allow both frontend origins)
GOOGLE_CLIENT_ID=your_google_web_client_id.apps.googleusercontent.com

# Cloudinary Storage
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Email (SMTP; password-reset email requires valid provider credentials)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_email_app_password
SMTP_FROM="Thư viện <no-reply@library.example.com>"

# Scheduled jobs endpoint secret (production: random secret of at least 32 characters)
JOBS_SECRET=local_jobs_secret_replace_before_production_0123456789
DISABLE_INTERNAL_CRON=false

# Swagger UI. Disable in production unless intentionally exposed.
ENABLE_DOCS=true
